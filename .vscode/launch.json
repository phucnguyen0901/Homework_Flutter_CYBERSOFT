    "version": "0.2.0",
    "configurations": [
        {
            "name": "homework_grocery_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "homework_grocery_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "homework_grocery_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Flutter (Linux Desktop Mobile Size)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "linux",
                "--window-width=412",
                "--window-height=892"
            ]
        }
    ]
}